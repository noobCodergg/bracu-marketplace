NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Optional comma-separated additional exact frontend origins (no wildcards).
CLIENT_URLS=
MONGODB_URI=mongodb://127.0.0.1:27017/bracu_marketplace
JWT_SECRET=replace-with-at-least-32-random-characters
# Keep disabled on free-tier production; raw request records amplify database writes.
ENABLE_REQUEST_DB_TELEMETRY=false
DB_MAX_POOL_SIZE=10
AUTH_CACHE_TTL_MS=30000
# Load shedding: execute 40 API requests, queue 160, then return 503 instead of exhausting memory.
API_MAX_IN_FLIGHT=40
API_MAX_QUEUE=160
API_QUEUE_TIMEOUT_MS=5000
TRUST_PROXY_HOPS=1
# Optional one-time admin bootstrap (password must be at least 12 characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Platform Admin
